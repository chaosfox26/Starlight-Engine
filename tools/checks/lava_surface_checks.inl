#include "rejection_note.hpp"
template<class Require> void lava_surface_checks(Require require,const fs::path& folder){
    auto scene=std::make_unique<SceneData>();require(scene->LavaInitialHeat==1&&scene->LavaCoolingRate==.012&&scene->LavaCrustDepth==.08&&scene->LavaLightStrength==1,"Legacy lava retains hot initial state with moderate cooling, crust and emitted light");
    scene->LavaInitialHeat=.8;scene->LavaCoolingRate=.02;scene->LavaCrustDepth=.12;scene->LavaLightStrength=2;
    {auto saved=std::make_unique<SceneData>(SceneData::decode(scene->encode()));require(saved->LavaInitialHeat==.8&&saved->LavaCoolingRate==.02&&saved->LavaCrustDepth==.12&&saved->LavaLightStrength==2,"Lava surface settings round trip through saved scenes");}
    auto jsonScene=json::parse(scene->encode());for(auto [key,value]:std::vector<std::pair<std::string,double>>{{"LavaInitialHeat",1.1},{"LavaCoolingRate",-.01},{"LavaCrustDepth",.31},{"LavaLightStrength",8.1}}){auto invalid=jsonScene;invalid[key]=value;bool rejected=false;try{auto saved=std::make_unique<SceneData>(SceneData::decode(invalid.dump()));}catch(...){rejected=true;note_rejection(__FILE__,__LINE__);}require(rejected,"Invalid authored lava settings are rejected");}
    scene->Terrain.emplace();scene->Terrain->WaterEnabled=true;scene->Terrain->Lava=true;scene->Terrain->WaterLevel=1;
    auto flow=std::make_unique<TerrainFlow>(*scene->Terrain,std::vector<LiquidSource>{});flow->lava_settings(1,.04,.12,1,true);double volume=flow->volume();
    auto hot=flow->geometry();double hotRelief=0;bool valid=true;for(const auto& part:hot)for(const auto& v:part.mesh.vertices){hotRelief=std::max(hotRelief,v.position.y-1.009);valid&=v.kind>8.05&&v.kind<8.15&&v.color.y>=0&&v.color.y<=1&&v.color.z>=0&&v.color.z<=1&&std::abs(v.normal.length()-1)<1e-8;}
    require(valid&&hotRelief>.02&&hotRelief<=.12,"Lava carries actual bounded crust relief, heat/coverage and smooth normals");
    auto hotLights=flow->lava_lights();require(hotLights.size()==4,"Large lava surfaces distribute emitted light across four occupied regions");
    for(int i=0;i<1200;++i)flow->step(1./120.);double heat=flow->lava_heat_at(0,0);require(heat>0&&heat<.7&&std::abs(flow->volume()-volume)<1e-8,"Surface lava cools over time without removing simulated fluid volume");
    auto cooled=flow->geometry();double coldRelief=0;for(const auto& part:cooled)for(const auto& v:part.mesh.vertices)coldRelief=std::max(coldRelief,v.position.y-1.009);require(coldRelief>hotRelief,"Cooling thickens actual lava crust geometry");
    auto lights=flow->lava_lights();double hotPower=0,coldPower=0;for(const auto& light:hotLights)hotPower+=light[8];for(const auto& light:lights)coldPower+=light[8];require(coldPower<hotPower*.5,"Cooling reduces scene illumination as glowing lava loses heat");
    flow->lava_settings(0,0,.12,1,true);require(flow->lava_lights().empty()&&flow->lava_heat_at(0,0)==0,"Fully cold authored lava emits no synthetic light");
    flow->lava_settings(1,0,.12,0,true);for(int i=0;i<120;++i)flow->step(1./120.);require(flow->lava_heat_at(0,0)==1&&flow->lava_lights().empty(),"Disabled cooling retains heat while emitted-light control independently disables light");
    {auto mixed=std::make_unique<TerrainFlow>(*scene->Terrain,std::vector<LiquidSource>{});mixed->lava_settings(.4,0,.08,1,true);mixed->lava.fill(0);mixed->lava[TerrainFlow::index(0,0)]=2;double initial=mixed->volume();for(int i=0;i<240;++i)mixed->step(1./120.);bool transported=true;for(int z=0;z<48;++z)for(int x=0;x<48;++x)if(mixed->lava[z*48+x]>.002)transported&=std::abs(mixed->lava_heat_at(-12+(x+.5)*.5,-12+(z+.5)*.5)-.4)<1e-8;require(transported&&std::abs(initial-mixed->volume())<1e-8,"Lava transport advects heat with conserved molten mass instead of inventing hot cells");}
    {auto occupied=std::make_unique<SceneData>(*scene);occupied->Characters.clear();for(int i=0;i<32;++i){Character light;light.Shape="light";light.Id="authored-"+std::to_string(i);light.X=i*.1;occupied->Characters.push_back(light);}auto preserved=environment_lights(*occupied,0,flow.get());require(preserved.size()==32&&preserved.back()[0]>3,"Lava illumination never evicts the existing thirty-two authored light slots");}
    scene->Name="Moving and cooling lava crust";scene->Hour=20;scene->FogDensity=.003;scene->LavaInitialHeat=1;scene->LavaCoolingRate=.02;scene->LavaCrustDepth=.12;scene->LavaLightStrength=1;scene->Terrain->WaterLevel=0;
    for(int z=0;z<97;++z)for(int x=0;x<97;++x){double px=x*.25-12,pz=z*.25-12;scene->Terrain->Heights[z*97+x]=.35-1.5*std::exp(-(px*px+pz*pz)/34);scene->Terrain->Paint[z*97+x]=3;}
    Character stone;stone.Shape="boulder";stone.Id="lava-bank-rock";stone.X=5;stone.Z=1;stone.Size=2;stone.Surface=4;stone.Color="#84817B";scene->Characters={stone};
    auto save=[&](const char* name,const TerrainFlow* state){auto packet=render_scene(*scene,state);atomic_write(folder/(std::string(name)+".bin"),std::string_view(reinterpret_cast<const char*>(packet.data()),packet.size()));};
    auto basin=std::make_unique<TerrainFlow>(*scene->Terrain,std::vector<LiquidSource>{});basin->lava_settings(1,.02,.12,1,true);save("lava-crust-hot",basin.get());for(int i=0;i<240;++i)basin->step(1./120.);save("lava-crust-motion",basin.get());for(int i=0;i<3360;++i)basin->step(1./120.);save("lava-crust-cooled",basin.get());basin->lava_settings(0,0,.12,1,true);save("lava-crust-cold",basin.get());
    auto initial=std::make_unique<TerrainFlow>(*scene->Terrain,std::vector<LiquidSource>{});initial->lava_settings(1,.02,.12,0,true);save("lava-crust-unlit",initial.get());atomic_write(folder/"lava-crust.starscene",scene->encode());
    atomic_write(folder/"lava-crust-diagnostics.json",json{{"hotMaximumRelief",hotRelief},{"cooledMaximumRelief",coldRelief},{"heatAfterTenSeconds",heat},{"hotLightPower",hotPower},{"cooledLightPower",coldPower},{"volume",volume},{"thermalScope","Normalized surface heat and mass-carried cooling proxy; phase change, solid collision and full thermodynamics remain open"}}.dump(2));
}
