!/editor/checks/corner-controls/top-edge.png
!/editor/checks/bottom-bar/
/editor/checks/bottom-bar/*
!/editor/checks/bottom-bar/shapes-bar.png
!/editor/checks/feature-panel.png
!/editor/checks/editor-preview.png

# Local credentials and machine-specific settings must never enter checkpoints.
.env
.env.*
*.pem
*.key
*.pfx
*.p12
CMakeUserPresets.json

# Required small GLB regression fixtures (not generated build output).
!/migration/fixtures/
/migration/fixtures/*
!/migration/fixtures/triangle.glb
!/migration/fixtures/deep-node-graph.glb

# Required baseline packet used by the rendering audit; other captures stay local.
!/audit-runs/
/audit-runs/*
!/audit-runs/run-20260917-192850/
/audit-runs/run-20260917-192850/*
!/audit-runs/run-20260917-192850/comparison.bin

# Owner-designated current project documentation.
!/Starlight Documents/
/Starlight Documents/*
!/Starlight Documents/Current/

# Current Analysis Tool entry point.
!/Launch-Starlight-Analysis.cmd

# Private historical evidence is local, not publication input.
/Starlight Documents/Current/history/
!/deep/README.md
