# Canonical Starlight tool sources (including tools/build, not build output).
!/tools/README.md
!/tools/*.json
!/tools/build/
!/tools/build/*.py
!/tools/checks/
!/tools/diagnostics/
!/tools/render/
!/tools/profiling/
!/tools/launch/

# Migration tool (the only legacy scene reader), shipped starter key cards and the small in-repo starter asset library.
!/tools/migration/
/tools/migration/*
!/tools/migration/*.cpp
!/tools/migration/*.md
!/starters/
/starters/*
!/starters/*/
/starters/*/*
!/starters/*/*.starscene
!/library/
/library/*
!/library/library.json
!/library/sculpt-*.slasset
!/library/terrain-*.slasset

# Packaging scripts and sources referenced by the build; outputs and staged payloads stay ignored.
!/tools/packaging/
/tools/packaging/*
!/tools/packaging/*.py
!/tools/packaging/*.cpp
!/tools/packaging/*.hpp
!/tools/packaging/*.ps1
!/tools/packaging/*.json
!/tools/packaging/*.txt

# Maintained editor asset-workflow documentation.
!/docs/
/docs/*
!/docs/REUSABLE-OBJECTS.md
!/docs/PORTABLE-SCENES.md

!/docs/ADVENTURE-CONTROLS.md

# Version project requirements and handoff records along with the implementation.
!/*.md
!/docs/*.md
!/editor/*.md
!/migration/*.md

# Small regression inputs are source fixtures; test outputs remain ignored.
!/editor/checks/
/editor/checks/*
!/editor/checks/denoise/
/editor/checks/denoise/*
!/editor/checks/denoise/regression/
/editor/checks/denoise/regression/*
!/editor/checks/denoise/regression/chaos-rt.packet
!/editor/checks/denoise/regression/DXR-preview.starscene
