/*
!/.gitignore
!/.gitmodules
!/README.md
!/STARLIGHT-PRODUCT-DIRECTION.md
!/Build-Native.py
!/CMakeLists.txt
!/CMakePresets.json
!/Launch-Starlight-Editor.cmd
!/cmake/
!/editor/
/editor/*
!/editor/cpp/
!/editor/native/
!/deep/
/deep/*
!/deep/engine/
!/deep/Physics/
!/deep/src/
!/deep/projects/
!/deep/settings/
!/deep/third_party/
/deep/third_party/*
!/deep/third_party/JoltPhysics/
!/design/
/design/*
!/design/branding/
!/migration/
/migration/*
!/migration/verify_no_managed.py
!/migration/geometry-reference.json
!/tools/
/tools/*
!/tools/audit/
**/build/
**/bin/
**/generated/
**/__pycache__/
*.before-*
*.bak
*.BAK
*.obj
*.pdb
*.dll
*.exe
*.lib
*.exp
*.log
*.lock

# Canonical Starlight tool sources (including tools/build, not build output).
!/tools/README.md
!/tools/*.json
!/tools/build/
!/tools/build/*.py
!/tools/checks/
!/tools/diagnostics/
!/tools/render/
!/tools/profiling/
!/tools/launch/

# Maintained editor asset-workflow documentation.
!/docs/
/docs/*
!/docs/REUSABLE-OBJECTS.md
!/docs/PORTABLE-SCENES.md

!/docs/ADVENTURE-CONTROLS.md

# Version project requirements and handoff records along with the implementation.
!/*.md
!/docs/*.md
!/editor/*.md
!/migration/*.md

# Small regression inputs are source fixtures; test outputs remain ignored.
!/editor/checks/
/editor/checks/*
!/editor/checks/denoise/
/editor/checks/denoise/*
!/editor/checks/denoise/regression/
/editor/checks/denoise/regression/*
!/editor/checks/denoise/regression/chaos-rt.packet
!/editor/checks/denoise/regression/DXR-preview.starscene

# Local credentials and machine-specific settings must never enter checkpoints.
.env
.env.*
*.pem
*.key
*.pfx
*.p12
CMakeUserPresets.json

# Required small GLB regression fixtures (not generated build output).
!/migration/fixtures/
/migration/fixtures/*
!/migration/fixtures/triangle.glb
!/migration/fixtures/deep-node-graph.glb

# Required baseline packet used by the rendering audit; other captures stay local.
!/audit-runs/
/audit-runs/*
!/audit-runs/run-20260917-192850/
/audit-runs/run-20260917-192850/*
!/audit-runs/run-20260917-192850/comparison.bin
