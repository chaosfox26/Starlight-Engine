// Included inside PhysicsWorld; cable bodies share its collision world.
 struct Cable {BodyID source,target;std::vector<BodyID> links;std::vector<float> halfLengths;std::vector<Ref<TwoBodyConstraint>> constraints;std::vector<RVec3> previous;};
 std::vector<Cable> cables;
 std::vector<RVec3> CablePoints(const Cable& cable){std::vector<RVec3> points;auto& api=world.GetBodyInterface();for(size_t i=0;i<cable.links.size();++i){RVec3 p;Quat q;api.GetPositionAndRotation(cable.links[i],p,q);Vec3 axis=q*Vec3(0,cable.halfLengths[i],0);if(i==0)points.push_back(p-axis);points.push_back(p+axis);}return points;}
 void RemoveCables(BodyID endpoint){auto& api=world.GetBodyInterface();for(auto it=cables.begin();it!=cables.end();)if(it->source==endpoint||it->target==endpoint){for(auto& constraint:it->constraints)world.RemoveConstraint(constraint);for(auto link:it->links){api.RemoveBody(link);api.DestroyBody(link);allProps.erase(std::remove(allProps.begin(),allProps.end(),link),allProps.end());std::lock_guard lock(contacts.mutex);contacts.touching.erase(link.GetIndexAndSequenceNumber());}if(it->source!=endpoint)api.ActivateBody(it->source);if(it->target!=endpoint&&!it->target.IsInvalid())api.ActivateBody(it->target);it=cables.erase(it);}else ++it;}
 void AddCable(uint32_t source,uint32_t target,const float* p,int segments,float radius){
  if(!p||source==target||segments<2||segments>64||!std::isfinite(radius)||radius<.005f||radius>.5f)throw std::runtime_error("Invalid segmented rope");
  for(int i=0;i<10;++i)if(!std::isfinite(p[i]))throw std::runtime_error("Invalid rope anchor");
  Vec3 a(p[0],p[1],p[2]),b(p[3],p[4],p[5]),delta=b-a;float span=delta.Length();
  if(p[9]<span-.001f||p[9]<=.02f||p[9]>1000||span<.001f)throw std::runtime_error("Rope length must reach both anchors");
  BodyID ends[]={BodyID(source),BodyID(target)};{BodyLockMultiWrite lock(world.GetBodyLockInterface(),ends,target==UINT32_MAX?1:2);if(!lock.GetBody(0)||!lock.GetBody(0)->IsDynamic()||(target!=UINT32_MAX&&!lock.GetBody(1)))throw std::runtime_error("Rope requires live endpoints");}
  Vec3 axis=delta/span,side=Vec3(0,-1,0)-axis*axis.Dot(Vec3(0,-1,0));if(side.LengthSq()<.001f)side=Vec3::sAxisX();else side=side.Normalized();
  auto points=[&](float sag){std::vector<Vec3> out;for(int i=0;i<=segments;++i){float t=float(i)/segments;out.push_back(a+delta*t+side*(sag*std::sin(JPH_PI*t)));}return out;};
  float low=0,high=p[9];for(int i=0;i<30;++i){float mid=(low+high)*.5f;auto path=points(mid);float length=0;for(int j=1;j<=segments;++j)length+=(path[j]-path[j-1]).Length();if(length<p[9])low=mid;else high=mid;}auto path=points((low+high)*.5f);
  cables.push_back({ends[0],ends[1]});auto& cable=cables.back();auto& api=world.GetBodyInterface();Ref<GroupFilterTable> groups=new GroupFilterTable(segments);for(int i=1;i<segments;++i)groups->DisableCollision(i-1,i);
  try{
  for(int i=0;i<segments;++i){Vec3 d=path[i+1]-path[i];float half=d.Length()*.5f,r=std::min(radius,half*.9f);CapsuleShapeSettings shape(half-r,r);shape.mDensity=1000;auto cooked=shape.Create();if(cooked.HasError())throw std::runtime_error(cooked.GetError().c_str());BodyCreationSettings settings(cooked.Get(),RVec3((path[i]+path[i+1])*.5f),Quat::sFromTo(Vec3::sAxisY(),d.Normalized()),EMotionType::Dynamic,1);settings.mCollisionGroup=CollisionGroup(groups,source,i);settings.mFriction=.6f;settings.mLinearDamping=.1f;settings.mAngularDamping=.2f;settings.mMotionQuality=EMotionQuality::LinearCast;auto id=api.CreateAndAddBody(settings,EActivation::Activate);if(id.IsInvalid())throw std::runtime_error("Rope body capacity reached");cable.links.push_back(id);cable.halfLengths.push_back(half);allProps.push_back(id);}
  for(int i=0;i<=segments;++i){BodyID ids[]={i==0?ends[0]:cable.links[i-1],i==segments?ends[1]:cable.links[i]};Ref<TwoBodyConstraint> constraint;{BodyLockMultiWrite lock(world.GetBodyLockInterface(),ids,ids[1].IsInvalid()?1:2);auto* first=lock.GetBody(0);auto* second=ids[1].IsInvalid()?&Body::sFixedToWorld:lock.GetBody(1);PointConstraintSettings settings;settings.mPoint1=settings.mPoint2=RVec3(path[i]);settings.mNumVelocityStepsOverride=16;settings.mNumPositionStepsOverride=4;constraint=settings.Create(*first,*second);}world.AddConstraint(constraint);cable.constraints.push_back(constraint);}
  cable.previous=CablePoints(cable);api.ActivateBody(ends[0]);
  }catch(...){
   auto& failed=cables.back();for(auto& constraint:failed.constraints)world.RemoveConstraint(constraint);
   for(auto link:failed.links){api.RemoveBody(link);api.DestroyBody(link);allProps.erase(std::remove(allProps.begin(),allProps.end(),link),allProps.end());}
   cables.pop_back();throw;
  }
 }
 int CablePath(uint32_t source,float* out,int capacity,bool interpolate){for(const auto& cable:cables)if(cable.source==BodyID(source)){auto points=CablePoints(cable);if(!out)throw std::runtime_error("Missing rope output buffer");if(capacity<int(points.size()))throw std::runtime_error("Rope path capacity too small");float alpha=interpolate?std::clamp(float(accumulator*60),0.f,1.f):1.f;for(size_t i=0;i<points.size();++i){auto p=points[i];if(cable.previous.size()==points.size())p=cable.previous[i]+(p-cable.previous[i])*alpha;out[i*3]=float(p.GetX());out[i*3+1]=float(p.GetY());out[i*3+2]=float(p.GetZ());}return int(points.size());}return 0;}
