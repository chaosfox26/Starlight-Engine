function(starlight_configure_upscalers target)
 if(NOT TARGET ${target})
  message(FATAL_ERROR "starlight_configure_upscalers: no target named ${target}")
 endif()
 if(target STREQUAL "Starlight.Viewport")
  message(FATAL_ERROR "starlight_configure_upscalers: Starlight.Viewport (editor viewport) stays upscale-off by standing rule")
 endif()
 get_target_property(existing ${target} SOURCES)
 foreach(required IN ITEMS upscale_off.cpp upscale_stubs.cpp)
  string(REGEX MATCH "${required}" found "${existing}")
  if(NOT found)
   message(FATAL_ERROR "starlight_configure_upscalers: ${target} must already compile ${required}; it provides the off backend and the factories for any disabled vendor")
  endif()
 endforeach()
 target_compile_definitions(${target} PRIVATE "UP_DEFAULT_REQUEST=\"${STARLIGHT_UPSCALER_DEFAULT}\"")
 set(copy_dir "$<TARGET_FILE_DIR:${target}>")
 if(STARLIGHT_UPSCALER_RUNTIME_LAYOUT STREQUAL "launcher")
  if(NOT TARGET Starlight)
   message(FATAL_ERROR "STARLIGHT_UPSCALER_RUNTIME_LAYOUT=launcher needs the Starlight launcher target to be defined before ${target}")
  endif()
  set(copy_dir "$<TARGET_FILE_DIR:Starlight>")
 endif()
 if(STARLIGHT_UPSCALER_HAVE_DLSS)
  target_sources(${target} PRIVATE "${_up_dir}/upscale_dlss.cpp")
  target_compile_definitions(${target} PRIVATE UP_HAVE_DLSS)
  target_include_directories(${target} PRIVATE "${STARLIGHT_UPSCALER_STREAMLINE_SDK}/include")
 endif()
 if(STARLIGHT_UPSCALER_HAVE_FSR)
  target_sources(${target} PRIVATE "${_up_dir}/upscale_fsr.cpp")
  target_compile_definitions(${target} PRIVATE UP_HAVE_FSR)
  target_include_directories(${target} PRIVATE "${STARLIGHT_FIDELITYFX_SDK}/api/include" "${STARLIGHT_FIDELITYFX_SDK}/upscalers/include" "${STARLIGHT_FIDELITYFX_SDK}/framegeneration/include")
 endif()
 if(STARLIGHT_UPSCALER_HAVE_XESS)
  target_sources(${target} PRIVATE "${_up_dir}/upscale_xess.cpp")
  target_compile_definitions(${target} PRIVATE UP_HAVE_XESS)
  target_include_directories(${target} PRIVATE "${STARLIGHT_XESS_SDK}/inc")
 endif()
 if(STARLIGHT_UPSCALER_HAVE_ANTILAG2)
  target_compile_definitions(${target} PRIVATE UP_HAVE_ANTILAG2)
  target_include_directories(${target} PRIVATE "${STARLIGHT_ANTILAG2_SDK}")
 endif()
 set(vendor_dirs DLSS:Streamline FSR:FidelityFX XESS:XeSS ANTILAG2:AntiLag2)
 foreach(entry IN LISTS vendor_dirs)
  string(REPLACE ":" ";" entry_parts "${entry}")
  list(GET entry_parts 0 vendor)
  list(GET entry_parts 1 folder)
  if(NOT STARLIGHT_UPSCALER_HAVE_${vendor})
   continue()
  endif()
  if(STARLIGHT_UPSCALER_${vendor}_DLLS)
   add_custom_command(TARGET ${target} POST_BUILD
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${copy_dir}"
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different ${STARLIGHT_UPSCALER_${vendor}_DLLS} "${copy_dir}"
    VERBATIM)
  endif()
  add_custom_command(TARGET ${target} POST_BUILD
   COMMAND "${CMAKE_COMMAND}" -E make_directory "${copy_dir}/licenses/${folder}"
   COMMAND "${CMAKE_COMMAND}" -E copy_if_different ${STARLIGHT_UPSCALER_${vendor}_NOTICES} "${copy_dir}/licenses/${folder}"
   VERBATIM)
 endforeach()
 add_custom_command(TARGET ${target} POST_BUILD
  COMMAND "${CMAKE_COMMAND}" -E make_directory "${copy_dir}"
  COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${CMAKE_BINARY_DIR}/upscalers/upscaler-manifest.txt" "${copy_dir}"
  VERBATIM)
endfunction()
