set(_up_manifest "# Starlight vendor upscaler integration (generated at configure time)\n")
string(APPEND _up_manifest "default request: ${STARLIGHT_UPSCALER_DEFAULT}\nruntime layout: ${STARLIGHT_UPSCALER_RUNTIME_LAYOUT}\n")
foreach(vendor IN ITEMS DLSS FSR XESS ANTILAG2)
 if(STARLIGHT_UPSCALER_HAVE_${vendor})
  string(APPEND _up_manifest "${vendor}: enabled\n")
  foreach(file IN LISTS STARLIGHT_UPSCALER_${vendor}_DLLS STARLIGHT_UPSCALER_${vendor}_NOTICES)
   file(SHA256 "${file}" _up_hash)
   string(APPEND _up_manifest "  ${_up_hash}  ${file}\n")
  endforeach()
 else()
  string(APPEND _up_manifest "${vendor}: disabled\n")
 endif()
endforeach()
