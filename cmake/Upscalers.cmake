endif()

function(_starlight_upscaler_probe vendor option_name sdk_var)
 set(required ${ARGN})
 if(NOT ${option_name})
  message(STATUS "Upscaler ${vendor}: disabled by ${option_name}=OFF; ${vendor} is compiled out and requests for it fall back to the off backend with a log line")
  set(STARLIGHT_UPSCALER_HAVE_${vendor} OFF PARENT_SCOPE)
  return()
 endif()
 set(missing "")
 foreach(relative IN LISTS required)
  if(NOT EXISTS "${${sdk_var}}/${relative}")
   list(APPEND missing "${${sdk_var}}/${relative}")
  endif()
 endforeach()
 if(missing)
  list(JOIN missing "\n  " missing_text)
  message(FATAL_ERROR "Upscaler ${vendor}: ${sdk_var} is incomplete or not set. Missing:\n  ${missing_text}\nSet ${sdk_var} (or STARLIGHT_UPSCALER_SDK_ROOT) to the vendor SDK, or configure with -D${option_name}=OFF to build without ${vendor}. Nothing is skipped silently.")
 endif()
 message(STATUS "Upscaler ${vendor}: enabled, SDK ${${sdk_var}}")
 set(STARLIGHT_UPSCALER_HAVE_${vendor} ON PARENT_SCOPE)
endfunction()

